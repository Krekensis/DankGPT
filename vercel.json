{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/chat.py": { "maxDuration": 50 }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/chat.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
